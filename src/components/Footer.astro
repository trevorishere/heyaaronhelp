---
const links = [
  { href: '/', label: 'Home' },
  { href: '/coaching', label: 'Coaching' },
  { href: '/about', label: 'About' },
  { href: '/press', label: 'Press' },
  { href: '/projects', label: 'Projects' },
  { href: '/contact', label: 'Contact' },
];

// TODO: replace with Aaron's real profile URLs.
const social = [
  { href: '#', label: 'Instagram', src: '/images/icon-instagram.svg', w: 45.5, h: 45.5 },
  { href: '#', label: 'YouTube', src: '/images/icon-youtube.svg', w: 49, h: 38.5 },
  { href: '#', label: 'LinkedIn', src: '/images/icon-linkedin.svg', w: 45.5, h: 45.5 },
];
---

<footer class="site-footer">
  <div class="container inner">
    <a href="/" class="mark" aria-label="Home">
      <img src="/images/logo-footer.png" alt="" width="60" height="60" />
    </a>

    <ul class="social">
      {social.map((s) => (
        <li>
          <a href={s.href} aria-label={s.label}>
            <img src={s.src} alt="" width={s.w} height={s.h} />
          </a>
        </li>
      ))}
    </ul>

    <nav aria-label="Footer">
      <ul class="links">
        {links.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <p class="copyright">
      © 2024. Designed by <span>Freshlymade</span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy);
    padding: 60px 0 70px;
  }

  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .mark {
    opacity: 0.5;
    margin-bottom: 36px;
  }

  .mark img {
    width: 60px;
    height: 60px;
  }

  .social {
    display: flex;
    gap: 28px;
  }

  .social a {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    opacity: 0.8;
    transition: opacity 0.2s ease;
  }

  .social a:hover {
    opacity: 1;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 28px;
    max-width: 320px;
    margin-top: 20px;
  }

  .links a {
    color: var(--footer-text);
    font-size: 14px;
    line-height: 21px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .links a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .copyright {
    margin-top: 24px;
    color: var(--footer-muted);
    opacity: 0.68;
    font-size: 12px;
    line-height: 21px;
    letter-spacing: 0.3px;
  }

  .copyright span {
    color: var(--footer-text);
  }

  @media (min-width: 768px) {
    .site-footer {
      padding: 80px 0 100px;
    }

    .social {
      gap: 48px;
    }

    .links {
      gap: 16px 40px;
      max-width: none;
      margin-top: 28px;
    }

    .links a {
      font-size: 16px;
    }

    .copyright {
      margin-top: 28px;
      font-size: 14px;
    }
  }

  @media (min-width: 1100px) {
    .links {
      gap: 48px;
    }
  }
</style>
