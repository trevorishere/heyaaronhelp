---
interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;

const links = [
  { href: '/coaching', label: 'Coaching' },
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/press', label: 'Press' },
];
---

<header class:list={['site-header', { overlay }]}>
  <div class="container bar">
    <a href="/" class="logo" aria-label="Hey Aaron Help — home">
      <img src="/images/logo-header.png" alt="" width="65" height="65" />
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <span class="visually-hidden">Menu</span>
      <span class="bars" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>

    <nav id="site-nav" class="nav" aria-label="Main">
      <ul class="links">
        {links.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
      <a href="/contact" class="nav-cta">Get Started</a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    header?.classList.toggle('open', open);
  });
  matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
    if (e.matches && toggle) {
      toggle.setAttribute('aria-expanded', 'false');
      header?.classList.remove('open');
    }
  });
</script>

<style>
  /* Mobile: sticky white bar with dropdown menu */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--white);
    box-shadow: 0 1px 12px rgba(41, 41, 41, 0.12);
  }

  .bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
  }

  .logo img {
    width: 48px;
    height: 48px;
  }

  .menu-toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -6px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .bars {
    position: relative;
    display: block;
    width: 24px;
    height: 18px;
  }

  .bars span {
    position: absolute;
    left: 0;
    width: 24px;
    height: 2px;
    border-radius: 10px;
    background: var(--ink-dark);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .bars span:nth-child(1) { top: 0; }
  .bars span:nth-child(2) { top: 8px; }
  .bars span:nth-child(3) { top: 16px; }

  .open .bars span:nth-child(1) { transform: translateY(8px) rotate(45deg); }
  .open .bars span:nth-child(2) { opacity: 0; }
  .open .bars span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }

  .nav {
    display: none;
    position: absolute;
    top: 100%;
    left: calc(-1 * var(--gutter));
    right: calc(-1 * var(--gutter));
    flex-direction: column;
    align-items: center;
    gap: 24px;
    padding: 16px var(--gutter) 40px;
    background: var(--white);
    box-shadow: 0 12px 12px -8px rgba(41, 41, 41, 0.12);
  }

  .open .nav {
    display: flex;
  }

  .links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .links a {
    display: block;
    padding: 8px;
    color: var(--ink);
    font-size: 16px;
    font-weight: 600;
    line-height: 24px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .links a:hover {
    color: var(--navy);
  }

  .nav-cta {
    padding: 12px 24px;
    border-radius: 24px;
    background: var(--ink-dark);
    color: var(--white);
    font-size: 14px;
    font-weight: 600;
    line-height: 20px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .nav-cta:hover {
    background: #1f1f1f;
  }

  /* Tablet + desktop: inline nav */
  @media (min-width: 768px) {
    .site-header {
      position: relative;
      box-shadow: none;
    }

    .site-header.overlay {
      position: absolute;
      inset: 0 0 auto;
      background: transparent;
    }

    .logo img {
      width: 56px;
      height: 56px;
    }

    .menu-toggle {
      display: none;
    }

    .nav,
    .open .nav {
      display: flex;
      position: static;
      flex-direction: row;
      gap: 16px;
      padding: 0;
      background: none;
      box-shadow: none;
    }

    .links {
      flex-direction: row;
      gap: 4px;
    }

    .links a {
      padding: 4px 8px;
      font-size: 15px;
    }
  }

  @media (min-width: 1100px) {
    .logo img {
      width: 65px;
      height: 65px;
    }

    .nav,
    .open .nav {
      gap: 24px;
    }

    .links {
      gap: 16px;
    }

    .links a {
      font-size: 16px;
    }
  }
</style>
